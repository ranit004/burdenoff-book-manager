# Copy to `.env` and adjust as needed:  cp .env.example .env
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string used by Prisma. The user/password/database/port here must
# stay in sync with the POSTGRES_* values below, which docker-compose.yml reads
# when it provisions the container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmark_manager?schema=public"

# Consumed by docker-compose.yml. The compose file falls back to these exact
# defaults if no .env exists, so `docker compose up -d` works on a clean clone.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookmark_manager
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the GraphQL Yoga server listens on.
PORT=4000
