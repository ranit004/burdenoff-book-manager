{
  "name": "bookmark-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GraphQL API for managing bookmarks organized into folders.",
  "module": "src/server.ts",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "5",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {}
}
